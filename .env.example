# Backend
BACK_PORT=8000
APP_HOST=0.0.0.0

# Python
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Frontend / Nginx
FRONT_PORT=10000

# Backend URL for Nginx proxy.
# Local Docker Compose:
BACKEND_URL=http://backend:8000

# For deploy, replace it with your public backend URL, for example:
# BACKEND_URL=https://your-backend.onrender.com

# PostgreSQL
POSTGRES_DB=quotes_db
POSTGRES_USER=quotes_user
POSTGRES_PASSWORD=change_me

# SQL async database URL.
DATABASE_URL=postgresql+asyncpg://quotes_user:change_me@postgres:5432/quotes_db