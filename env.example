# ── .env (добавь эти переменные) ─────────────────────────────────────────────

POSTGRES_DB=quotes_db
POSTGRES_USER=quotes_user
POSTGRES_PASSWORD=super_secret_password_change_me

# Для backend-сервиса (формируется автоматически из переменных выше)
DATABASE_URL=postgresql+asyncpg://quotes_user:super_secret_password_change_me@postgres:5432/quotes_db
